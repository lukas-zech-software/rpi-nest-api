{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {"include": "*.env", "outDir": "./dist"}
    ],
    "watchAssets": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "controllerKeyOfComment": "summary",
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ]
  }
}
