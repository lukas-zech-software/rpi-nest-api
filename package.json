{
  "name": "rpi-nest-api",
  "description": "API for Raspberry-Nest devices",
  "version": "0.0.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "nest build",
    "build:watch": "nest build --watch",
    "build:dev": "nest build -b swc",
    "build:clean": "rm -rf ./dist",
    "deploy:target": "tools/target/deploy/deploy-to-target.sh",
    "deploy:target:src-only": "tools/target/deploy/deploy-to-target.sh 1",
    "deploy:target:setup": "tools/target/setup/setup-new-target.sh",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "cli": "node dist/cli --",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:docker": "npm run build && npm run dev:init-environment && npm run start:dev",
    "start:debug": "nest start --debug --watch",
    "start:test": "npm run test:init-environment && NODE_ENV=testing node dist/main",
    "start:prod": "NODE_ENV=production node dist/main",
    "start:target": "ssh \"api@$RPI\" 'node dist/main'",
    "test": "npm run test:unit && npm run test:integration && npm run test:spec",
    "test:init-environment": "tools/init-test-environment.sh",
    "test:unit": "NODE_ENV=testing jest --config=jest.config.json",
    "test:unit:watch": "NODE_ENV=testing jest --config=jest.config.json --watch",
    "test:unit:cov": "NODE_ENV=testing jest --config=jest.config.json --coverage",
    "test:unit:debug": "NODE_ENV=testing node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "npm run test:init-environment && NODE_ENV=testing jest --config test/integration/jest-integration.json",
    "test:spec": "npx --yes dredd",
    "lint": "npm run test:init-environment && npm run lint:code && npm run lint:spec",
    "lint:code": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:code:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:spec": "NODE_ENV=testing WRITE_SPEC_ONLY=true npm run start && spectral lint rpi-nest-api.spec.json --verbose",
    "pre-commit": "npm run lint:code && npm run test:unit",
    "prod:init-environment": "tools/init-prod-environment.sh",
    "dev:init-environment": "tools/init-dev-environment.sh",
    "dev:reset-environment": "tools/reset-dev-environment.sh",
    "dev:export-spec": "npx openapi2postmanv2 -s rpi-nest-api.spec.json -o rpi-nest-api.collection.json -p -c ./openapi2postman.config.json",
    "docker:start:dev": "docker/docker-run-dev.sh",
    "docker:publish:dev": "docker/docker-publish.sh dev",
    "docker:publish:ci": "docker/docker-publish.sh ci",
    "prepare": "husky install"
  },
  "dependencies": {
    "@nestjs/common": "^10.2.8",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dbus-final": "github:Jelmerro/dbus-final",
    "helmet": "^7.1.0",
    "lmdb": "^2.8.5",
    "lodash": "^4.17.21",
    "nest-commander": "^3.11.0",
    "prom-client": "github:siimon/prom-client",
    "reflect-metadata": "^0.1.13",
    "tar-fs": "^3.0.4"
  },
  "devDependencies": {
    "@automock/jest": "^1.4.0",
    "@nestjs/cli": "^12.0.6",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@stoplight/spectral-cli": "^6.11.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.3.96",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.2",
    "@types/lodash": "^4.14.201",
    "@types/node": "^18.18.9",
    "@types/supertest": "^2.0.16",
    "@types/tar-fs": "^2.0.4",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^8.0.3",
    "jest": "29.5.0",
    "nest-commander-schematics": "^3.0.0",
    "openapi-to-postmanv2": "^6.3.3",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3",
    "ts-jest": "29.1.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.1.6"
  }
}
